# glass-earth-bot settings for running on your own computer.
#
# Copy this file to a new file called .env in this folder, then type each
# value after its = sign. The .gitignore file already lists .env, so git never
# commits it. Never put these values in code, logs, commits or chat.
#
# On GitHub, the same three names go in Settings > Secrets and variables >
# Actions > New repository secret (scripts/go_live.py can set them).

# Token for your Metaculus bot account (on Metaculus: Settings > My Forecasting Bots).
METACULUS_TOKEN=

# Your OpenRouter key (https://openrouter.ai/keys). Every model call uses it.
OPENROUTER_API_KEY=

# The key that seals each forecast in the public ledger until its question
# closes: 32 random bytes in URL-safe base64. Make one with
#   python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# and keep a copy somewhere safe besides this file: GitHub never shows a
# secret again, and without the key no sealed forecast can be revealed.
# Only a run that posts to Metaculus needs it; dry runs do not.
GLASS_EARTH_LEDGER_KEY=
