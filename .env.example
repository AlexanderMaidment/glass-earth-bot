# glass-earth-bot settings for running on your own computer.
#
# Copy this file to a new file called .env in this folder, then type each
# value after its = sign. The .gitignore file already lists .env, so git never
# commits it. Never put these values in code, logs, commits or chat.
#
# On GitHub, the same two names go in Settings > Secrets and variables >
# Actions > New repository secret.

# Token for your Metaculus bot account (on Metaculus: Settings > My Forecasting Bots).
METACULUS_TOKEN=

# Your OpenRouter key (https://openrouter.ai/keys). Every model call uses it.
OPENROUTER_API_KEY=
