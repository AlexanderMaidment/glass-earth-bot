# Forecast records are hashed and timestamped, so git must never change their
# bytes (no line-ending conversion on any computer).
forecasts/** -text

# Ledger lines are only ever appended. When two runs append at the same time,
# keep both sets of lines instead of stopping with a conflict.
forecasts/ledger.jsonl merge=union
forecasts/proofs/index.jsonl merge=union

# OpenTimestamps receipts are binary files.
*.ots binary

# The commit script runs under bash on the GitHub runner.
*.sh text eol=lf
